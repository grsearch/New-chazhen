# LaserStream / Yellowstone gRPC。按顺序故障切换；不要把真实 Token 提交到 Git。
SDBR_GRPC_ENDPOINTS=https://laserstream-mainnet-lax.helius-rpc.com,https://laserstream-mainnet-slc.helius-rpc.com
SDBR_GRPC_TOKEN=
# 默认真正节省流量：PumpSwap日志 + 轻量transaction status（含slot/index），不接收完整交易元数据。
# 紧急回退到旧模式时可设为full-transactions；旧模式会恢复高额LaserStream流量。
SDBR_STREAM_MODE=logs-status
# 日志流与按需池/Mint元数据查询使用；留空时由SDBR_GRPC_TOKEN自动生成Helius主网RPC地址。
SDBR_RPC_URL=
SDBR_LOG_STATUS_JOIN_TTL_MS=30000
SDBR_LOG_STATUS_JOIN_WINDOW_MS=300000
SDBR_LOG_STATUS_JOIN_BUCKET_MS=1000
SDBR_POOL_RESOLVE_RETRY_MS=30000
SDBR_POOL_CACHE_MAX=200000
# 轻量模式仅监听PumpSwap，不监听海量迁移前Pump交易。
# full-transactions模式下设为true才会恢复精确迁移时间，并显著增加Helius消耗。
SDBR_INCLUDE_PUMP_LIFECYCLE=false

# 本地研究存储与只读 Dashboard。
SDBR_DB_PATH=./data/sdbr-research.db
SDBR_DASHBOARD_HOST=127.0.0.1
SDBR_DASHBOARD_PORT=8787
# 历史汇总缓存30秒，避免Dashboard刷新反复扫描SQLite大表。
SDBR_DASHBOARD_SUMMARY_CACHE_MS=30000

# 可选的、只使用信号发生前已知信息的钱包拒绝列表（逗号分隔）。
SDBR_TOXIC_WALLETS=
SDBR_RELATED_WALLETS=

# 直接砸单矩阵：仅PumpSwap迁移后币，不限制AGE；最低5 SOL且冲击跌幅最低8%。
# 信号桶、1 SOL仓位、E0/E100/E300和退出矩阵固化在代码中。
SDBR_DUMP_BOUNCE_MATRIX_ENABLED=true
SDBR_MAX_DUMP_DROP_PCT=99
SDBR_DUMP_MATRIX_ENTRY_TIMEOUT_MS=5000
SDBR_DUMP_MATRIX_EXIT_TIMEOUT_MS=3000
SDBR_DUMP_MATRIX_EXIT_GRACE_MS=30000
SDBR_DUMP_MATRIX_BASE_TX_FEE_SOL=0.000005
SDBR_DUMP_MATRIX_PRIORITY_FEE_SOL=0.0001
SDBR_DUMP_MATRIX_JITO_TIP_SOL=0

# 通用报价容量与数据质量保护。
SDBR_MAX_REPORTED_RECOVERY_PCT=500
SDBR_BUY_SLIPPAGE_BPS=100
SDBR_SELL_SLIPPAGE_BPS=100
# 入场前即时买卖往返保护：含AMM费、双边滑点、Priority/Jito/基础交易费。
SDBR_MAX_ROUND_TRIP_LOSS_PCT=8
SDBR_MAX_ENTRY_LIQUIDITY_USAGE_PCT=10
SDBR_MAX_EXIT_LIQUIDITY_USAGE_PCT=10
SDBR_BASE_TX_FEE_SOL=0.000005
SDBR_PRIORITY_FEE_SOL=0.0005
SDBR_JITO_TIP_SOL=0
# Dashboard的NO_EXIT压力情景按买入和卖出各一笔计算这些Tip档位。
SDBR_JITO_TIP_SCENARIOS_SOL=0,0.005,0.01,0.02
SDBR_NO_EXIT_SCENARIO_LOSS_PCTS=-15,-100

# Same-Slot、下一Slot、观察钱包和旧Causal Backrun策略已经停用，旧.env中的相关开关会被忽略。

# 数据质量隔离：异常成交额、储备、成交/储备占比、价格偏差或短时储备跳变不计收益。
SDBR_DATA_MAX_TRADE_SOL=1000
SDBR_DATA_MAX_QUOTE_RESERVE_SOL=10000
SDBR_DATA_MAX_TRADE_TO_QUOTE_PCT=50
SDBR_DATA_MAX_EVENT_RESERVE_DEVIATION_PCT=100
SDBR_DATA_MAX_QUOTE_RESERVE_CHANGE_MULTIPLE=5

# 研究数据批量写入。
SDBR_DB_FLUSH_MS=500
SDBR_DB_BATCH_MAX=500
# 只保存砸盘事件窗口；结构化字段已足够审计，默认不再重复保存完整 JSON。
SDBR_STORE_TRADE_RAW_JSON=false
# 窗口成交与 Slot 摘要保留30天；砸盘、确认和模拟结果不受此期限影响。
SDBR_TRADE_RETENTION_DAYS=30
SDBR_SLOT_RETENTION_DAYS=30
SDBR_DB_MAINTENANCE_MS=600000
SDBR_DB_MAINTENANCE_BATCH=10000

# 本机健康与磁盘保护。低Join率只定向重连Stream；持续硬故障才由systemd重启。
SDBR_HEALTH_STARTUP_GRACE_MS=180000
SDBR_HEALTH_MIN_JOIN_SAMPLES=100
SDBR_HEALTH_MIN_JOIN_RATE_PCT=90
SDBR_HEALTH_RECOVERY_CHECKS=2
SDBR_HEALTH_RECOVERY_COOLDOWN_MS=120000
SDBR_HEALTH_RECOVERY_BACKOFF_MULTIPLIER=2
SDBR_HEALTH_RECOVERY_MAX_COOLDOWN_MS=900000
SDBR_HEALTH_RECOVERY_MAX_ATTEMPTS=3
SDBR_HEALTH_RECOVERY_RESET_HEALTHY_MS=300000
SDBR_HEALTH_FATAL_CHECKS=5
SDBR_HEALTH_EXIT_ON_FATAL=true
SDBR_HEALTH_MIN_DISK_FREE_GB=10
SDBR_HEALTH_MIN_DISK_FREE_PCT=10
