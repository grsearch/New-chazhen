# Install on the server as /etc/new-chazhen/backup-cos.env with mode 0600.
# Never commit real credentials.
SDBR_BACKUP_COS_SECRET_ID=
SDBR_BACKUP_COS_SECRET_KEY=
SDBR_BACKUP_COS_BUCKET=your-bucket-appid
SDBR_BACKUP_COS_REGION=your-region
SDBR_BACKUP_COS_ENDPOINT=cos.your-region.myqcloud.com
SDBR_BACKUP_COS_PREFIX=post-dump-recovery/daily
SDBR_BACKUP_COS_THREADS=4
SDBR_BACKUP_UPLOAD_TIMEOUT=30m
SDBR_BACKUP_VERIFY_TIMEOUT=5m
SDBR_BACKUP_LOCAL_RETENTION_DAYS=2
